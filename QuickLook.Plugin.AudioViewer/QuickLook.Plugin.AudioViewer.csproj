<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>QuickLook.Plugin.AudioViewer</AssemblyName>
    <RootNamespace>QuickLook.Plugin.AudioViewer</RootNamespace>
    <!-- Single-sourced from Directory.Build.props so the DLL version tracks the
         plugin version instead of defaulting to 1.0.0.0. -->
    <Version>$(PluginVersion)</Version>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host supplies QuickLook.Common at runtime; never ship a second copy. -->
    <ProjectReference Include="..\QuickLook.Common\QuickLook.Common.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- QuickLook's installer reads this exact filename from the .qlplugin zip and
         parses /Metadata/Version. It must be QuickLook.Plugin.Metadata.config. -->
    <None Update="QuickLook.Plugin.Metadata.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
