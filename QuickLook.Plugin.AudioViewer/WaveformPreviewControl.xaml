<UserControl x:Class="QuickLook.Plugin.AudioViewer.WaveformPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:QuickLook.Plugin.AudioViewer.Controls"
             Background="Transparent">

  <Grid Background="Transparent">

    <!-- The whole preview: one waveform, a playhead, and the time. Click/drag anywhere to seek. -->
    <Grid x:Name="Area" Background="Transparent" ClipToBounds="True"
          MouseLeftButtonDown="OnAreaMouseDown"
          MouseMove="OnAreaMouseMove"
          MouseLeftButtonUp="OnAreaMouseUp"
          LostMouseCapture="OnAreaLostMouseCapture">

      <!-- Margins define the drawing area; the playhead repeats the same left/top/bottom so
           its X offset (a render transform) maps straight onto the waveform's width. -->
      <ctl:WaveformView x:Name="Waveform" Margin="16,14,16,30" IsHitTestVisible="False"/>

      <Rectangle x:Name="Playhead" Width="1" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                 Margin="16,14,0,30" IsHitTestVisible="False" Visibility="Collapsed">
        <Rectangle.RenderTransform>
          <TranslateTransform x:Name="PlayheadShift"/>
        </Rectangle.RenderTransform>
      </Rectangle>

      <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="12" Visibility="Collapsed" IsHitTestVisible="False"/>

      <TextBlock x:Name="TimeText" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="18,0,0,8" FontFamily="Consolas, Courier New" FontSize="11"/>
    </Grid>

    <!-- Volume, on the same bottom line as the time but at the right edge. A sibling of the
         seek surface rather than a child of it, so dragging it never seeks, and left with
         the stock template so it looks like the rest of the system.

         No Value here on purpose: the control sets it from the level this session is at, and
         an initial Value in markup would fire ValueChanged while loading and overwrite it. -->
    <Slider x:Name="VolumeSlider" Width="90" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,16,4" Minimum="0" Maximum="1"
            IsMoveToPointEnabled="True"
            Focusable="False" ToolTip="Volume"
            ValueChanged="OnVolumeChanged"/>

    <!-- Play / pause, centred on the same bottom line. Focusable="False" is load-bearing:
         a focused button would swallow Space, and Space belongs to QuickLook (it closes the
         preview). It is a sibling of the seek surface for the same reason the slider is. -->
    <Button x:Name="PlayPauseButton" Content="播放" Width="112" Height="24"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
            Focusable="False" IsTabStop="False"
            Click="OnPlayPauseClick"/>
  </Grid>
</UserControl>
