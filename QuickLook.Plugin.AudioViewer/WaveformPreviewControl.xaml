<UserControl x:Class="QuickLook.Plugin.AudioViewer.WaveformPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:QuickLook.Plugin.AudioViewer.Controls"
             Background="Transparent">

  <Grid Background="Transparent">

    <!-- The whole preview: one waveform, a playhead, and the time. Click/drag anywhere to seek. -->
    <Grid x:Name="Area" Background="Transparent" ClipToBounds="True"
          MouseLeftButtonDown="OnAreaMouseDown"
          MouseMove="OnAreaMouseMove"
          MouseLeftButtonUp="OnAreaMouseUp"
          LostMouseCapture="OnAreaLostMouseCapture">

      <!-- Margins define the drawing area; the playhead repeats the same left/top/bottom so
           its X offset (a render transform) maps straight onto the waveform's width. -->
      <ctl:WaveformView x:Name="Waveform" Margin="16,14,16,30" IsHitTestVisible="False"/>

      <Rectangle x:Name="Playhead" Width="1" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                 Margin="16,14,0,30" IsHitTestVisible="False" Visibility="Collapsed">
        <Rectangle.RenderTransform>
          <TranslateTransform x:Name="PlayheadShift"/>
        </Rectangle.RenderTransform>
      </Rectangle>

      <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="12" Visibility="Collapsed" IsHitTestVisible="False"/>

      <TextBlock x:Name="TimeText" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="18,0,0,8" FontFamily="Consolas, Courier New" FontSize="11"/>
    </Grid>

    <!-- Auto-play and volume, right edge of the same bottom line. Both sit in a panel so their
         spacing does not depend on hand-tuned margins, and both are siblings of the seek
         surface: a control inside it would seek as well as do its own job.

         No IsChecked/Value in markup on purpose: the control seeds them from the remembered
         state, and an initial value here would fire the handlers while loading and overwrite
         it. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,4">
      <CheckBox x:Name="AutoPlayCheck" Content="自动播放" VerticalAlignment="Center"
                Margin="0,0,12,0" Focusable="False" IsTabStop="False"
                ToolTip="打开预览时自动开始播放（对所有文件生效）"
                Checked="OnAutoPlayChanged" Unchecked="OnAutoPlayChanged"/>
      <Slider x:Name="VolumeSlider" Width="90" VerticalAlignment="Center"
              Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
              Focusable="False" IsTabStop="False" ToolTip="音量"
              ValueChanged="OnVolumeChanged"/>
    </StackPanel>

    <!-- Play / pause, centred on the same bottom line. An icon rather than text: the host's
         button style is not Aero2's, its padding differs, and a text label in a fixed-height
         button came out clipped. Focusable="False" is load-bearing: a focused button would
         swallow Space, and Space belongs to QuickLook (it closes the preview). It is a sibling
         of the seek surface for the same reason the slider is. Padding="0" keeps the content
         box the full button, whatever padding the host's style would otherwise apply. -->
    <Button x:Name="PlayPauseButton" Width="112" Height="24" Padding="0"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
            Focusable="False" IsTabStop="False" ToolTip="播放 / 暂停"
            Click="OnPlayPauseClick">
      <Path x:Name="PlayIcon" HorizontalAlignment="Center" VerticalAlignment="Center"
            Stretch="None"
            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
            Data="M 0,0 L 9,6 L 0,12 Z"/>
    </Button>
  </Grid>
</UserControl>
